apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: k8s-manifests
  annotations:
    config.kubernetes.io/local-config: "true"
info:
  description: sample description
pipeline:
  mutators:
    # Validate FIRST: schema-driven validation of app-config against
    # app-config-schema (kind: JsonSchema). KPT runs validators only AFTER all
    # mutators, so to fail fast on bad input BEFORE any transformation, we run
    # this validation as the first mutator. It only reads + fail()s; it never
    # mutates resources.
    - image: ghcr.io/kptdev/krm-functions-catalog/starlark:v0.5.5
      configPath: validator-all.yaml
    # KPT catalog function: sets metadata.namespace on every namespaced resource
    # (and repoints RoleBinding/CRB subjects). Reads data.namespace from the
    # unified app-config ConfigMap — a ready-made function, no custom code needed.
    - image: ghcr.io/kptdev/krm-functions-catalog/set-namespace:v0.4.5
      configPath: app-config.yaml
    # Branding must run before its two apply-replacements steps, which copy the
    # branding-derived ConfigMaps (active-postgresql-init, value-store) into the
    # shop Deployments/ConfigMaps.
    - image: ghcr.io/kptdev/krm-functions-catalog/starlark:v0.5.5
      configPath: setup-branding.yaml
    - image: ghcr.io/kptdev/krm-functions-catalog/apply-replacements:v0.1.5
      configPath: branding/replace-postgresql-init.yaml
    - image: ghcr.io/kptdev/krm-functions-catalog/apply-replacements:v0.1.5
      configPath: branding/branding-image-provider.yaml
    # Region must run before its apply-replacements step, which copies the
    # region-derived active-region-postgresql-init ConfigMap into postgresql-init.
    - image: ghcr.io/kptdev/krm-functions-catalog/starlark:v0.5.5
      configPath: setup-region.yaml
    - image: ghcr.io/kptdev/krm-functions-catalog/apply-replacements:v0.1.5
      configPath: regional/replace-postgresql-region.yaml
    # setup-extras runs profile + chaos + cluster-scope in ONE starlark call.
    # (Namespace metadata is handled by the set-namespace catalog function above;
    # setup-extras only does the namespace-dependent cluster-scope fixups.)
    - image: ghcr.io/kptdev/krm-functions-catalog/starlark:v0.5.5
      configPath: setup-extras.yaml
